# MongoDB connection string (Atlas or self-hosted).
# Example Atlas URI:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database name used by the app (collections are created automatically).
MONGODB_DB=expense_tracker

# Optional: shared-secret bearer token required to call the MCP endpoint.
# Leave unset to allow unauthenticated MCP access (fine for local dev only).
MCP_AUTH_TOKEN=
